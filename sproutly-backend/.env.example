NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://sproutly:sproutly@localhost:5432/sproutly?schema=public

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32+-char-random-secret
BETTER_AUTH_URL=http://localhost:4000

# Comma-separated list of allowed frontend origins (CORS + Better Auth trustedOrigins)
CORS_ORIGINS=http://localhost:8081

# Native app deep-link schemes trusted by Better Auth (comma-separated)
APP_SCHEMES=sproutly

# Google sign-in (optional). Create an OAuth 'Web application' client in Google Cloud and add
# the authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
